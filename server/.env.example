FIREBASE_PROJECT_ID=your-firebase-project-id
# ADC を自分のアカウントで作った場合（gcloud auth application-default login）はこの行を消す
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# API キーを作れない場合（組織のポリシーなど）は空にすると、ADC で Places を呼ぶ
GOOGLE_MAPS_API_KEY=your-maps-api-key
# 国内の電車・バス・徒歩経路。未設定では経路検索を含む操作が503になる
MIXWAY_API_KEY=your-mixway-api-key
# 空にすると、ADC で Vertex AI の Gemini を呼ぶ（GOOGLE_CLOUD_LOCATION は既定 global）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-available-gemini-model
GOOGLE_CLOUD_LOCATION=global
PORT=8080
# 公開時の設定（手元では空でよい）
# Firebase Hosting の rewrite で /api/** を転送するときの前置き
API_BASE_PATH=
# ブラウザから別のオリジンで呼ぶときに許可するオリジン（カンマ区切り。例: http://localhost:*）
CORS_ALLOWED_ORIGINS=
